# Copy to .env. Set both required secrets before running Compose.
APP_IMAGE=research-output-claims:local
WEB_PORT=8000

POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=
# Compose fixes POSTGRES_HOST=db and POSTGRES_PORT=5432.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
# Keep 127.0.0.1 for the in-container health check.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=0

FIXTURE_SOURCE_URL=http://fixture-source:8081
# Optional, for seed_demo only (at least 12 characters); leave empty on a release host.
DEMO_PASSWORD=
